datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  STAFF
}

enum OrderStatus {
  PENDING_PAYMENT
  PAYMENT_SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
}

model User {
  id             String    @id @default(uuid())
  email          String    @unique
  passwordHash   String
  name           String
  role           Role      @default(STAFF)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  ticketsChecked Ticket[]  @relation("StaffCheckIn")
}

model Event {
  id          String       @id @default(uuid())
  title       String
  slug        String       @unique
  subtitle    String?
  description String
  date        DateTime
  location    String
  venue       String
  bannerUrl   String?
  isActive    Boolean      @default(true)
  maxCapacity Int
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  ticketTypes TicketType[]
  orders      Order[]
}

model TicketType {
  id             String      @id @default(uuid())
  eventId        String
  event          Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  price          Float
  totalQuota     Int
  remainingQuota Int
  saleStartDate  DateTime?
  saleEndDate    DateTime?
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  tickets        Ticket[]
  orderItems     OrderItem[]
}

model PaymentSetting {
  id            String   @id @default(uuid())
  bankName      String
  accountType   String
  accountNumber String
  accountHolder String
  holderId      String
  instructions  String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Order {
  id                   String      @id @default(uuid())
  orderNumber          String      @unique
  eventId              String
  event                Event       @relation(fields: [eventId], references: [id])
  buyerName            String
  buyerEmail           String
  buyerPhone           String
  buyerDocumentId      String
  totalAmount          Float
  status               OrderStatus @default(PENDING_PAYMENT)
  proofReceiptUrl      String?
  proofReferenceNumber String?
  adminNotes           String?
  expiresAt            DateTime
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  orderItems           OrderItem[]
  tickets              Ticket[]
}

model OrderItem {
  id           String     @id @default(uuid())
  orderId      String
  order        Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticketTypeId String
  ticketType   TicketType @relation(fields: [ticketTypeId], references: [id])
  quantity     Int
  unitPrice    Float
  subtotal     Float
}

model Ticket {
  id                 String     @id @default(uuid())
  ticketCode         String     @unique
  orderId            String
  order              Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticketTypeId       String
  ticketType         TicketType @relation(fields: [ticketTypeId], references: [id])
  attendeeName       String
  attendeeEmail      String
  attendeeDocumentId String
  qrCodeData         String
  isCheckedIn        Boolean    @default(false)
  checkedInAt        DateTime?
  checkedInById      String?
  checkedInBy        User?      @relation("StaffCheckIn", fields: [checkedInById], references: [id])
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
}

