# ========================================================
# TEDx USFX 2026 - VARIABLES DE ENTORNO DE PRODUCCIÓN (BACKEND)
# ========================================================

# Puerto del servidor backend en el contenedor o VPS
PORT=4000
NODE_ENV=production

# Base de datos PostgreSQL (Asegura una clave segura y esquema público)
# Formato: postgresql://<USUARIO>:<PASSWORD>@<HOST>:<PUERTO>/<DB>?schema=public
DATABASE_URL="postgresql://tedx_prod_user:ClaveSuperSegura2026!@localhost:5432/tedx_prod?schema=public"

# Clave secreta para firmar tokens JWT (Generar con: openssl rand -hex 32)
JWT_SECRET="reemplazar_con_un_hash_aleatorio_largo_generado_en_produccion"

# URLs permitidas por CORS (Frontend de producción, separadas por coma si hay varias)
# Ejemplo: "https://tedxusfx.com,https://www.tedxusfx.com"
CLIENT_URL="https://tedxusfx.com"

# Configuración de Correo Electrónico Transaccional (SMTP)
# Compatible con Brevo / Sendinblue, Gmail SMTP, Mailgun, Amazon SES o Resend
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT=587
SMTP_USER="tu_correo_o_usuario_smtp@dominio.com"
SMTP_PASS="tu_clave_smtp_secreta"
SMTP_FROM="TEDx USFX 2026 <tickets@tedxusfx.com>"

# Configuración WhatsApp (Evolution API v2 o v1.8+)
EVOLUTION_API_URL="http://evolution-api:8080"
EVOLUTION_API_KEY="clave_api_evolution_super_segura"
EVOLUTION_INSTANCE_NAME="tedxusfx2026"
DEFAULT_COUNTRY_CODE="591"
